server {
  listen 80;
  server_name _;
  client_max_body_size 512m;
  root /usr/share/nginx/html;

  # Security headers. CSP is enforced; ${CSP_CONNECT_EXTRA} (templated by the nginx image) adds the
  # object-store origin in production so presigned uploads/downloads work. APS Viewer needs autodesk.com.
  add_header X-Content-Type-Options "nosniff" always;
  add_header X-Frame-Options "DENY" always;
  add_header Referrer-Policy "strict-origin-when-cross-origin" always;
  add_header Permissions-Policy "camera=(), geolocation=(), microphone=(self)" always;
  add_header Content-Security-Policy "default-src 'self'; script-src 'self' https://developer.api.autodesk.com; style-src 'self' 'unsafe-inline' https://developer.api.autodesk.com; font-src 'self' data: https://developer.api.autodesk.com https://fonts.autodesk.com; img-src 'self' data: blob: https://*.autodesk.com ${CSP_CONNECT_EXTRA}; media-src 'self' blob: ${CSP_CONNECT_EXTRA}; connect-src 'self' https://*.autodesk.com wss://*.autodesk.com ${CSP_CONNECT_EXTRA}; worker-src 'self' blob:; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'" always;

  location /api/ {
    proxy_pass http://api:8000;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    # SSE progress stream
    proxy_buffering off;
    proxy_read_timeout 1h;
  }
  location / {
    try_files $uri /index.html;
  }
}
