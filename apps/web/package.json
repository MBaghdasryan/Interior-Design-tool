{
  "name": "@forma/web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b --noEmit",
    "api:types": "openapi-typescript openapi.json --default-non-nullable=false -o src/lib/api-types.ts",
    "api:check": "node scripts/api-contract-check.mjs"
  },
  "dependencies": {
    "@fontsource/manrope": "5.3.0",
    "@fontsource/noto-sans-armenian": "5.3.0",
    "lucide-react": "0.460.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.30.6",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@types/three": "0.170.0",
    "@vitejs/plugin-react": "4.3.4",
    "openapi-typescript": "7.13.0",
    "typescript": "5.6.3",
    "vite": "5.4.21"
  }
}
