# ---- copy to .env; never commit real secrets ----
BRAND_NAME=Renovara
ENV=development
SECRET_KEY=change-me-to-a-long-random-string
POSTGRES_PASSWORD=forma
PUBLIC_BASE_URL=http://localhost:8085
SEED_DEMO=true

# AI providers (any subset; without keys the deterministic rules stub is used and labelled as such)
AI_DEFAULT_PROVIDER=auto
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5
OPENAI_IMAGE_MODEL=gpt-image-2
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
AI_TIMEOUT_S=120

# Autodesk Platform Services (https://aps.autodesk.com) — import DWG/RVT/IFC, APS Viewer, DXF→DWG
APS_CLIENT_ID=
APS_CLIENT_SECRET=
APS_BUCKET_KEY=
APS_REGION=US
APS_DA_NICKNAME=
APS_DA_ACTIVITY_ALIAS=prod
APS_DA_ENGINE=Autodesk.AutoCAD+25_0

# External catalog discovery (allowlist lives in the DB; live fetching is opt-in)
EXTERNAL_CATALOG_ENABLED=true
# Global live switch — keep false by default. Even when true, only sources with live_enabled=true
# (seed: Domus only) are fetched; Profal is RFQ-only; the other six are disabled/pending.
EXTERNAL_FETCH_LIVE=false
EXTERNAL_FETCH_USER_AGENT=RenovaraCatalogBot/0.1 (+https://cubeappmaker.agency/bot)
EXTERNAL_DEFAULT_DELAY_S=3.0
EXTERNAL_FETCH_TIMEOUT_S=15
EXTERNAL_FETCH_MAX_RETRIES=2
EXTERNAL_FETCH_RATE_LIMIT_S=3.0
EXTERNAL_FETCH_MAX_REDIRECTS=3
EXTERNAL_FETCH_CONCURRENCY=1
EXTERNAL_FETCH_MAX_BYTES=5000000
EXTERNAL_DISCOVERY_MAX_REQUESTS=40
EXTERNAL_CACHE_ENABLED=true
EXTERNAL_ROBOTS_ENFORCED=true
EXTERNAL_SSRF_PROTECTION=true
EXTERNAL_PRICE_TTL_H=24
EXTERNAL_AVAILABILITY_TTL_H=12
EXTERNAL_SPECS_TTL_H=168
EXTERNAL_MEDIA_TTL_H=720

# Sessions & auth (HttpOnly session cookie + CSRF double-submit; bearer tokens for API clients)
SESSION_TTL_H=336
# keep true; browsers accept Secure cookies on http://localhost
COOKIE_SECURE=true
COOKIE_DOMAIN=
PASSWORD_MIN_LEN=10
VERIFY_TOKEN_TTL_H=48
RESET_TOKEN_TTL_MIN=60
TERMS_VERSION=2026-10
RATE_LIMIT_ENABLED=true
# e.g. redis://redis:6379/0 — shared rate limits and the job queue
REDIS_URL=

# E-mail: console writes .eml files to MAIL_DIR (dev); smtp sends for real
MAIL_BACKEND=console
MAIL_DIR=./data/mail
MAIL_FROM=Renovara <no-reply@your-domain>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Object storage: local | s3 (production profile uses S3-compatible SeaweedFS)
STORAGE_BACKEND=local
S3_BUCKET=renovara
S3_ENDPOINT=
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# empty when the object store encrypts at rest itself
S3_SSE=AES256
RETENTION_INCOMING_DAYS=1
RETENTION_MAIL_DAYS=30
RETENTION_ORPHAN_DAYS=7

# Observability (all optional)
# json in production
LOG_FORMAT=text
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=renovara-api
SENTRY_DSN=

# MFA (TOTP): enforced in production for these roles; MFA_ENFORCE=true forces it elsewhere
MFA_ENFORCE=
MFA_REQUIRED_ROLES=bureau_admin,platform_admin,platform_ops

# Antivirus (clamd INSTREAM): CLAMAV_HOST=clamav with `docker compose --profile av up -d`
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_REQUIRED=

# Privacy
PRIVACY_DELETION_GRACE_DAYS=14
RETENTION_PHOTOS_DAYS=365
RETENTION_AUDIT_DAYS=730

# AI models and budgets (costs are estimates: token/image counts × AI_PRICES table)
GEMINI_VISION_MODEL=gemini-3.1-pro-preview
RENDER_MODEL=gemini-3-pro-image
RENDER_IMAGE_SIZE=2K
AI_ORG_DAILY_USD=5
AI_ORG_MONTHLY_USD=50
AI_PRICES=

# Payments (P2-1). Empty = no provider: orders work as requests, the UI shows «Integration pending»,
# nothing is ever marked paid. stripe_compat needs all three values; idram | arca | ameriabank adapters
# are pending a contract and API documentation.
PAYMENT_PROVIDER=
PAYMENT_API_BASE=
PAYMENT_API_KEY=
PAYMENT_WEBHOOK_SECRET=
ORDER_RECHECK_MAX_AGE_H=24

# Semantic search (P2-4): local = multilingual lexical vectors, no network (default);
# gemini | auto use gemini-embedding-001 when GEMINI_API_KEY has quota; off disables it
SEARCH_EMBEDDINGS=local
